{
  "name": "dynsjs",
  "version": "1.0.0",
  "description": "Une bibliothèque JS pour générer dynamiquement des feuilles de style CSS.",
  "type": "module",
  "main": "dist/dynsjs.cjs.js",
  "module": "dist/dynsjs.esm.js",
  "browser": "dist/dynsjs.umd.js",
  "types": "dist/ts/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "build:js": "rollup -c",
    "build:types": "tsc --project tsconfig.json",
    "build": "npm run clean && npm run build:js && npm run build:types",
    "watch:js": "rollup -c -w",
    "watch:types": "tsc --watch --preserveWatchOutput --project tsconfig.json",
    "dev": "concurrently \"npm:watch:js\" \"npm:watch:types\"",
    "build:demo": "node compileStyles.js"
  },
  "keywords": [
    "css",
    "stylesheet",
    "dynamic",
    "js"
  ],
  "author": "Paterne G. G",
  "license": "MIT",
  "browserslist": [
    "> 0.2%",
    "not dead",
    "not op_mini all"
  ],
  "devDependencies": {
    "@babel/core": "7.27.1",
    "@babel/preset-env": "7.27.1",
    "@rollup/plugin-babel": "6.0.4",
    "@rollup/plugin-commonjs": "28.0.3",
    "@rollup/plugin-node-resolve": "16.0.1",
    "@rollup/plugin-terser": "^0.4.4",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.3",
    "rollup": "^4.4.0",
    "tailwindcss": "^4.1.5",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.1.5"
  }
}
