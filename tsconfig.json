// tsconfig.json (modifié)
{
    "compilerOptions": {
      "allowJs": true,
      "declaration": true,
      "emitDeclarationOnly": true,
      "declarationDir": "dist/ts",  // <-- MODIFIÉ : Spécifie le sous-dossier pour les .d.ts
      "outDir": "dist",             // Garder outDir pour la logique interne de tsc
      "moduleResolution": "node",
      "esModuleInterop": true,
      "skipLibCheck": true
    },
    "include": ["src/**/*", "tests"],
    "exclude": ["node_modules", "dist"]
  }